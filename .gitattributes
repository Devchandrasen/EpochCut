* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.cff text eol=lf
*.drawio text eol=lf
*.mmd text eol=lf
*.svg text eol=lf
*.excalidraw text eol=lf
*.ps1 text eol=crlf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary

# Conceptual visual exports are generated from code and diagram sources.
docs/assets/** linguist-generated=true
diagrams/*.svg linguist-generated=true
diagrams/*.png linguist-generated=true
diagrams/*.excalidraw linguist-generated=true
